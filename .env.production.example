# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
# Recommended volume mount path: /data

NODE_ENV=production
HK_DISABLE_SQLITE=1
SUSA_API_BASE_URL=https://api.skolverket.se/susa-navet/emil3
SUSA_SCHOOL_TYPE=HS
NEXT_PUBLIC_SITE_URL=https://www.xn--hgskolekompassen-mwb.se
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@hogskolekompassen.se

# Supabase/Postgres live-data source. Use a server-side connection string only.
# Supabase Dashboard > Connect > Direct connection or Transaction pooler.
# Example:
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-...pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=

# Optional overrides. Normally leave these unset on Railway.
# HK_DATA_DIR=/data
# HK_DB_PATH=/data/hogskolekompassen.sqlite
# HK_SUSA_CACHE_DIR=/data/.susa-sync-cache
# SUPABASE_POOL_MAX=5
# SUPABASE_DATABASE_SSL=disable # only for local non-SSL Postgres, not Supabase
